{
  "name": "@multiverse-com/pulsemon",
  "version": "0.3.0",
  "description": "Buffered, content-free-by-default ingest client for Pulsemon — the DPT realtime-observability receiver. Lives beside the receiver it speaks to.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stukennedy/pulsemon.git",
    "directory": "packages/client"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --format esm --target node && tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "bun test",
    "test:run": "bun test"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  }
}
