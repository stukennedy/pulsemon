{
  "name": "pulsemon",
  "main": "src/index.ts",
  "assets": {
    "directory": "public"
  },
  "compatibility_date": "2025-02-18",
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pulsemon-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW_TELEMETRY",
      "bucket_name": "pulsemon-raw-telemetry"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TELEMETRY_QUEUE",
        "queue": "pulsemon-telemetry"
      }
    ],
    "consumers": [
      {
        "queue": "pulsemon-telemetry",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "pulsemon-telemetry-dlq"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SEARCH_SESSION",
        "class_name": "SearchSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["SearchSession"]
    }
  ]
}
